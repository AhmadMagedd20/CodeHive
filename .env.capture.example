# Environment for `pnpm capture-assets` ONLY.
#
# The capture seed DELETES content rows, so it refuses to run unless
# DATABASE_URL points at a local host. Never put the Supabase URL here.
#
# Start a local Postgres first. Port 5433 by default, because 5432 is often
# already taken by another project's container:
#     DB_PORT=5433 docker compose up -d

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lms"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/lms"

SESSION_SECRET="capture-only-secret-not-for-production"
APP_URL="http://127.0.0.1:3210"

# Local disk storage for the demo lecture video.
STORAGE_PROVIDER="local"
STORAGE_DIR="./storage-capture"

EMAIL_PROVIDER="console"
CAPTCHA_ENABLED="false"

# Port the capture server listens on.
CAPTURE_PORT="3210"
