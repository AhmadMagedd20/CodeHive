// LMS Login & Registration — data model.
// See PROJECT.md §4 for the narrative description and rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase: pooled connection (Supavisor, port 6543, ?pgbouncer=true) for the
  // app runtime; direct/session-pooler connection (port 5432) for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum University {
  GUC
  GIU
}

/// Account lifecycle. Each state maps to a DISTINCT login behaviour — see
/// src/lib/auth/account-state.ts. Never collapse these into a boolean.
enum AccountState {
  PENDING_EMAIL_VERIFICATION
  PENDING_ADMIN_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
  DEACTIVATED
}

enum AuditEvent {
  LOGIN
  LOGOUT
  SESSION_REVOKED
  PASSWORD_RESET
  PASSWORD_CHANGED
  EMAIL_VERIFIED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  COURSE_ACCESS_GRANTED
  COURSE_ACCESS_REVOKED
}

// ---------------------------------------------------------------------------
// Instructor — the "admin". Seeded / CLI-created; never self-registers.
// Every Student and Course references an instructor, so nothing hardcodes
// "there is exactly one admin".
// ---------------------------------------------------------------------------

model Instructor {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  requiresTwoFactor Boolean  @default(false) // 2FA seam — no logic yet
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Self-serve purchase settings (InstaPay) — editable in admin settings.
  instapayHandle       String?
  instapayInstructions String?
  instapayQrAssetId    String?
  instapayQr           FileAsset? @relation("InstapayQr", fields: [instapayQrAssetId], references: [id])

  // Phase 4 — when on, marking a manual-drip student "Attended" for week N also
  // releases the Nth module to them. Off by default (attendance & release stay
  // separate unless the instructor opts in).
  attendanceAutoRelease Boolean @default(false)

  // Landing-page hero preview video — a PUBLIC marketing asset, deliberately
  // NOT a Video/LessonItem: no course, no gating, no watermark or download
  // protection. Uploaded through the same VideoProvider for storage mechanics
  // only. Null across the board = the hero falls back to its static mock.
  heroVideoProvider   String?
  heroVideoAssetId    String? // provider handle (local provider: the storage key)
  heroVideoStorageKey String?
  heroVideoStatus     VideoStatus?
  heroVideoFilename   String?
  heroPosterAssetId   String?
  heroPoster          FileAsset? @relation("HeroPoster", fields: [heroPosterAssetId], references: [id])

  students Student[]
  courses  Course[]
  session  Session? // polymorphic — an instructor also gets a single session

  // Phase 2
  announcements     Announcement[]
  feedbackSnippets  FeedbackSnippet[]
  gradedSubmissions Submission[]
  grantedUnlocks    StudentModuleUnlock[]

  // Purchase path
  reviewedPurchases Purchase[]

  // Phase 4 — in-person roster / drip / attendance
  rosterEntries     RosterEntry[]
  moduleReleases    StudentModuleRelease[]
  attendanceRecords AttendanceRecord[]

  @@map("instructors")
}

// ---------------------------------------------------------------------------
// Student — the self-registering account.
// ---------------------------------------------------------------------------

model Student {
  id                String       @id @default(cuid())
  username          String       @unique
  email             String       @unique
  university        University
  passwordHash      String
  fullName          String? // shown on certificates; falls back to username
  state             AccountState @default(PENDING_EMAIL_VERIFICATION)
  rejectionReason   String? // set when state = REJECTED (optional reason)
  emailVerifiedAt   DateTime?
  requiresTwoFactor Boolean      @default(false) // 2FA seam — no logic yet

  // Phase 4 — set true when the account registered with an instructor's code.
  // Drives in-person pricing (private 40% discount) and code auto-approval.
  isInPerson Boolean @default(false)

  // Phase 2 — engagement / at-risk tracking
  lastLearningActivityAt DateTime?

  // Login throttling
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Multi-tenancy: always non-null. Assigned at registration (see
  // src/lib/instructor.ts:getDefaultInstructor).
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseAccess        StudentCourseAccess[]
  session             Session?
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  // Phase 2
  lessonProgress      LessonProgress[]
  quizAttempts        QuizAttempt[]
  submissions         Submission[]
  notes               LessonNote[]
  bookmarks           Bookmark[]
  certificates        Certificate[]
  announcementReads   AnnouncementRead[]
  moduleUnlocks       StudentModuleUnlock[]
  streak              StudentStreak?
  activity            StudentActivity[]
  assignmentReminders AssignmentReminder[]
  purchases           Purchase[]
  moduleAccess        StudentModuleAccess[]

  // Phase 4
  rosterEntry    RosterEntry?
  moduleReleases StudentModuleRelease[]
  attendance     AttendanceRecord[]

  savedCourses SavedCourse[]

  @@index([instructorId])
  @@index([state])
  @@map("students")
}

// Course-level bookmark ("save this course") — distinct from the per-lesson
// Bookmark model. Toggled from course cards.
model SavedCourse {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("saved_courses")
}

// ---------------------------------------------------------------------------
// Course — belongs to an instructor.
// ---------------------------------------------------------------------------

model Course {
  id           String      @id @default(cuid())
  title        String
  description  String?
  category     String? // subject tag shown on cards + used by the dashboard filter pills
  university   University? // optional course<->university association
  gatingEnabled Boolean    @default(true) // per-course toggle for sequential gating

  // Self-serve purchase path. `priceCents` is EGP piastres.
  isPurchasable   Boolean @default(false)
  priceCents      Int?
  currency        String  @default("EGP")
  discountPercent Int?    // rounded % for badges/banner; kept in sync with salePriceCents
  salePriceCents  Int?    // EXACT on-sale price (source of truth for effective price); null = no sale
  comingSoon      Boolean @default(false) // teased on the catalog; buying is blocked

  instructorId String
  instructor   Instructor  @relation(fields: [instructorId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  access StudentCourseAccess[]

  // Phase 2
  modules       Module[]
  announcements Announcement[]
  certificates  Certificate[]

  // Purchase path
  purchases Purchase[]

  // Phase 4
  attendance AttendanceRecord[]

  savedBy SavedCourse[]

  @@index([instructorId])
  @@map("courses")
}

// ---------------------------------------------------------------------------
// StudentCourseAccess — explicit grant of a course to a student.
// Students only ever see courses they appear here for.
// ---------------------------------------------------------------------------

model StudentCourseAccess {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  grantedAt DateTime @default(now())

  // Phase 4 — per-student content-release mode for this course. Exactly one at
  // a time. See PROJECT.md for precedence. Default GATED reproduces pre-Phase-4
  // behaviour (GATED delegates to the existing gating, which is a no-op when
  // the course has gatingEnabled = false).
  accessMode CourseAccessMode @default(GATED)

  // Phase 4 — set true when an in-person student has PAID to unlock this course's
  // "extra" items (labs/LeetCode/extras). Also set by any approved self-serve
  // purchase (whole-course buyers get everything). Lecture items stay gated by
  // their access mode (attendance drip / gating); only extras key off this.
  extrasUnlocked Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("student_course_access")
}

// ---------------------------------------------------------------------------
// Session — server-side, opaque, single per account (strict single-session).
// Exactly one of studentId / instructorId is set. The unique constraints on
// each enforce "one active session per account".
// ---------------------------------------------------------------------------

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique // sha256 of the cookie token; raw token never stored
  studentId    String?  @unique
  instructorId String?  @unique
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  student    Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor Instructor? @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Verification & reset tokens — separate, single-use, expiring. Only the hash
// is stored; the raw token lives only in the emailed link.
// ---------------------------------------------------------------------------

model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([studentId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([studentId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// AuditLog — every login attempt (+ other security events). studentId is
// nullable so a failed login for an unknown email doesn't leak existence.
// ---------------------------------------------------------------------------

model AuditLog {
  id             String     @id @default(cuid())
  event          AuditEvent
  success        Boolean
  ip             String?
  userAgent      String?
  emailAttempted String? // what the user typed; recorded even when no student matched
  message        String?
  studentId      String?
  student        Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())

  @@index([studentId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// PHASE 2 — Courses & Content. See PROJECT.md "Phase 2" for narrative/decisions.
// ===========================================================================

enum LessonType {
  VIDEO
  DOCUMENT
  RICH_TEXT
  QUIZ
  ASSIGNMENT
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

enum QuizQuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED // auto-graded parts done; may await manual grading
  GRADED
}

enum SubmissionMode {
  CODE
  FILE
}

enum SubmissionStatus {
  SUBMITTED
  GRADED // graded; visible to student once releasedAt is set
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum AnnouncementScope {
  GLOBAL
  COURSE
}

// --- Structure -------------------------------------------------------------

model Module {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int       @default(0)
  isPublished Boolean   @default(false)
  publishAt   DateTime? // optional scheduled publish

  // Gating: unlocks when the prerequisite module's gating assignment is passed.
  // Null = no prerequisite (open).
  prerequisiteModuleId String?
  prerequisite         Module?  @relation("ModulePrereq", fields: [prerequisiteModuleId], references: [id])
  dependents           Module[] @relation("ModulePrereq")

  // Phase 5 — per-week pricing. A module with a price can be bought on its own;
  // null/0 means "full course only". Mirrors the course-level price triple so
  // sales work identically at both levels. The course price is INDEPENDENT of
  // the sum of its weeks (it's a bundle deal the instructor sets by hand).
  priceCents      Int?
  discountPercent Int? // rounded % for badges; kept in sync with salePriceCents
  salePriceCents  Int? // EXACT on-sale price (source of truth); null = no sale

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    LessonItem[]
  unlocks  StudentModuleUnlock[]
  releases StudentModuleRelease[]
  access   StudentModuleAccess[]
  purchases Purchase[]

  @@index([courseId])
  @@map("modules")
}

model LessonItem {
  id          String     @id @default(cuid())
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type        LessonType
  title       String
  orderIndex   Int       @default(0)
  isPublished  Boolean   @default(false)
  isFreePreview Boolean  @default(false) // publicly viewable without an account (catalog preview)
  isExtra      Boolean   @default(false) // paid extra (lab/LeetCode/etc.) — gated by payment for in-person students
  publishAt    DateTime?
  body         String? // RICH_TEXT payload (markdown); null for other types
  chapters     String? // optional video chapters, one "M:SS Label" per line
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Type-specific payloads (exactly one is set, matching `type`).
  video      Video?
  documentId String?    @unique
  document   FileAsset? @relation("DocumentFile", fields: [documentId], references: [id])
  quiz       Quiz?
  assignment Assignment?

  progress  LessonProgress[]
  notes     LessonNote[]
  bookmarks Bookmark[]

  @@index([moduleId])
  @@map("lesson_items")
}

// Provider-agnostic video record. See src/lib/video/*.
model Video {
  id              String      @id @default(cuid())
  lessonItemId    String      @unique
  lessonItem      LessonItem  @relation(fields: [lessonItemId], references: [id], onDelete: Cascade)
  provider        String      @default("local")
  providerAssetId String? // id/key the provider uses
  storageKey      String? // local provider: object key
  status          VideoStatus @default(READY)
  durationSeconds Int?
  originalFilename String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("videos")
}

// Generic uploaded file (documents, submission files, announcement images).
model FileAsset {
  id         String   @id @default(cuid())
  provider   String   @default("local")
  storageKey String // key/path within the provider
  filename   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  documentFor   LessonItem?    @relation("DocumentFile")
  submissions   Submission[]
  announcements Announcement[]
  instapayQrFor Instructor[]   @relation("InstapayQr")
  heroPosterFor Instructor[]   @relation("HeroPoster")
  purchases     Purchase[]

  @@map("file_assets")
}

// --- Quizzes (practice/tracking only) --------------------------------------

model Quiz {
  id               String     @id @default(cuid())
  lessonItemId     String     @unique
  lessonItem       LessonItem @relation(fields: [lessonItemId], references: [id], onDelete: Cascade)
  instructions     String?
  opensAt          DateTime?
  closesAt         DateTime?
  timeLimitMinutes Int?
  maxAttempts      Int? // null = unlimited
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id          String           @id @default(cuid())
  quizId      String
  quiz        Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  orderIndex  Int              @default(0)
  type        QuizQuestionType
  prompt      String
  options     Json? // MCQ options (array of strings)
  correct     Json? // MCQ: index/indices; TRUE_FALSE: bool; SHORT_ANSWER: null
  points      Int              @default(1)
  explanation String?
  createdAt   DateTime         @default(now())

  answers QuizAnswer[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id                 String        @id @default(cuid())
  quizId             String
  quiz               Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNo          Int           @default(1)
  status             AttemptStatus @default(IN_PROGRESS)
  startedAt          DateTime      @default(now())
  submittedAt        DateTime?
  score              Int? // awarded points
  maxScore           Int?
  needsManualGrading Boolean       @default(false)
  createdAt          DateTime      @default(now())

  answers QuizAnswer[]

  @@index([quizId])
  @@index([studentId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id               String       @id @default(cuid())
  attemptId        String
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response         Json?
  isCorrect        Boolean?
  awardedPoints    Int?
  needsManualGrade Boolean      @default(false)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("quiz_answers")
}

// --- Assignments -----------------------------------------------------------

model Assignment {
  id             String         @id @default(cuid())
  lessonItemId   String         @unique
  lessonItem     LessonItem     @relation(fields: [lessonItemId], references: [id], onDelete: Cascade)
  instructions   String?
  dueAt          DateTime?
  isGating       Boolean        @default(false)
  submissionMode SubmissionMode @default(FILE)
  codeLanguage   String? // default language hint for CODE mode
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  submissions Submission[]
  reminders   AssignmentReminder[]

  @@map("assignments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNo    Int              @default(1)
  submittedAt  DateTime         @default(now())
  isLate       Boolean          @default(false)
  mode         SubmissionMode
  codeContent  String?
  codeLanguage String?
  fileAssetId  String?
  fileAsset    FileAsset?       @relation(fields: [fileAssetId], references: [id])
  status       SubmissionStatus @default(SUBMITTED)
  passed       Boolean? // set on grading; gating unlocks on true
  score        Int? // optional numeric, tracking-only
  feedback     String?
  gradedAt     DateTime?
  gradedById   String?
  gradedBy     Instructor?      @relation(fields: [gradedById], references: [id])
  releasedAt   DateTime? // when grade+feedback becomes visible to the student

  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@map("submissions")
}

// Reusable feedback text the admin can insert then edit per submission.
model FeedbackSnippet {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  title        String
  body         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([instructorId])
  @@map("feedback_snippets")
}

// Dedupe record for the automatic ~24h-before due-date reminder.
model AssignmentReminder {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sentAt       DateTime   @default(now())

  @@unique([assignmentId, studentId])
  @@map("assignment_reminders")
}

// --- Progression overrides -------------------------------------------------

model StudentModuleUnlock {
  id          String      @id @default(cuid())
  studentId   String
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  grantedById String?
  grantedBy   Instructor? @relation(fields: [grantedById], references: [id])
  createdAt   DateTime    @default(now())

  @@unique([studentId, moduleId])
  @@index([moduleId])
  @@map("student_module_unlocks")
}

// --- Progress / engagement -------------------------------------------------

model LessonProgress {
  id                  String         @id @default(cuid())
  studentId           String
  student             Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonItemId        String
  lessonItem          LessonItem     @relation(fields: [lessonItemId], references: [id], onDelete: Cascade)
  status              ProgressStatus @default(IN_PROGRESS)
  watchedPercent      Int            @default(0) // video: max % watched
  lastPositionSeconds Int            @default(0) // video resume point
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([studentId, lessonItemId])
  @@index([lessonItemId])
  @@map("lesson_progress")
}

model LessonNote {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonItemId String
  lessonItem   LessonItem @relation(fields: [lessonItemId], references: [id], onDelete: Cascade)
  body         String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([studentId, lessonItemId])
  @@map("lesson_notes")
}

model Bookmark {
  id               String     @id @default(cuid())
  studentId        String
  student          Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonItemId     String
  lessonItem       LessonItem @relation(fields: [lessonItemId], references: [id], onDelete: Cascade)
  timestampSeconds Int? // for a specific point within a video
  label            String?
  createdAt        DateTime   @default(now())

  @@index([studentId])
  @@index([lessonItemId])
  @@map("bookmarks")
}

model StudentStreak {
  studentId      String    @id
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime? // UTC-midnight semantics
  updatedAt      DateTime  @updatedAt

  @@map("student_streaks")
}

model StudentActivity {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime // UTC midnight of an active day
  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@map("student_activity")
}

model Certificate {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  serial    String   @unique
  issuedAt  DateTime @default(now())

  @@unique([studentId, courseId])
  @@map("certificates")
}

// --- Announcements ---------------------------------------------------------

model Announcement {
  id           String            @id @default(cuid())
  instructorId String
  instructor   Instructor        @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  scope        AnnouncementScope @default(COURSE)
  courseId     String? // null for GLOBAL
  course       Course?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  body         String // limited formatting (bold, links)
  imageAssetId String?
  imageAsset   FileAsset?        @relation(fields: [imageAssetId], references: [id])
  publishAt    DateTime? // scheduled send; null = immediate
  sentAt       DateTime? // when email notifications were dispatched
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  reads AnnouncementRead[]

  @@index([courseId])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, studentId])
  @@index([studentId])
  @@map("announcement_reads")
}

// ===========================================================================
// Self-serve purchases (InstaPay screenshot review). See PROJECT.md "Purchases".
// ===========================================================================

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseScope {
  WHOLE_COURSE // the entire course (bundle) — grants every week, now and future
  MODULE // a single week, bought à la carte
}

model Purchase {
  id                String         @id @default(cuid())
  studentId         String
  student           Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Phase 5 — what was bought. MODULE purchases set `moduleId`; WHOLE_COURSE
  // leaves it null. The price fields below always describe THIS scope.
  scope             PurchaseScope  @default(WHOLE_COURSE)
  moduleId          String?
  module            Module?        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  priceCents        Int // FINAL amount actually charged (EGP piastres) — post all discounts
  currency          String         @default("EGP")
  // Phase 4 — price breakdown for clear records:
  listPriceCents          Int?    // the course's normal list price at purchase time
  effectivePriceCents     Int?    // public price after any active sale (pre in-person)
  inPersonDiscountApplied Boolean @default(false) // whether the private 40% was taken
  // Phase 5 — upgrade credit. On a WHOLE_COURSE purchase this is the total the
  // student had already PAID for approved single-week purchases in this course,
  // deducted from the amount charged (floored at zero). Null/0 = no credit.
  priorCreditCents        Int?
  screenshotAssetId String?
  screenshot        FileAsset?     @relation(fields: [screenshotAssetId], references: [id])
  status            PurchaseStatus @default(PENDING)
  rejectionReason   String?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        Instructor?    @relation(fields: [reviewedById], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([moduleId])
  @@map("purchases")
}

// ---------------------------------------------------------------------------
// StudentModuleAccess (Phase 5) — ownership of a single week, bought à la carte.
// Deliberately separate from StudentCourseAccess: the course-level row records
// that the student is ENROLLED (so the course lists on their dashboard and the
// existing guards pass), while these rows decide WHICH weeks they can open.
// Only consulted when the course grant's accessMode = PER_MODULE; a whole-course
// buyer gets FULL/GATED and never needs a row here.
// ---------------------------------------------------------------------------

model StudentModuleAccess {
  id        String   @id @default(cuid())
  studentId String
  moduleId  String
  grantedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@index([moduleId])
  @@map("student_module_access")
}

// ===========================================================================
// PHASE 4 — In-person students: registration codes, granular (drip) access,
// and weekly attendance. See PROJECT.md "Phase 4" for narrative/decisions.
// ===========================================================================

enum CourseAccessMode {
  FULL // entire course visible at once (no locks)
  DRIP // only modules the instructor has explicitly released are visible
  GATED // Phase 2 assignment gating (respects Course.gatingEnabled + prereqs)
  PER_MODULE // Phase 5 — à la carte: only weeks bought (StudentModuleAccess) are visible
}

enum AttendanceStatus {
  ATTENDED
  ABSENT
  // "not recorded yet" is the ABSENCE of a row, never a stored value.
}

/// One in-person student the instructor pre-registers, plus their single-use
/// registration code. Consuming the code links a real Student account (below).
/// Status is derived, not stored: revoked (revokedAt) > used (studentId) >
/// expired (codeExpiresAt) > unused. Structured so a CSV import can bulk-create
/// these later without schema changes.
model RosterEntry {
  id            String    @id @default(cuid())
  instructorId  String
  instructor    Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  name          String // the named student, for the instructor's reference
  email         String? // optional — used only to email the code
  notes         String?
  code          String    @unique // human-friendly, single-use
  codeExpiresAt DateTime? // optional expiry
  revokedAt     DateTime? // set when the instructor revokes an unused code
  usedAt        DateTime? // set when the code is consumed at registration

  // The account that registered with this code (1:1). SetNull keeps the roster
  // row (attendance/history) even if the account is later deleted.
  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
  @@map("roster_entries")
}

/// Drip release: the instructor has released one module (a "lecture"/"week")
/// to one student. Sole visibility driver in DRIP access mode. Distinct from
/// StudentModuleUnlock (a GATED-mode escape hatch) — do not conflate them.
model StudentModuleRelease {
  id           String      @id @default(cuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  moduleId     String
  module       Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  releasedById String?
  releasedBy   Instructor? @relation(fields: [releasedById], references: [id])
  createdAt    DateTime    @default(now())

  @@unique([studentId, moduleId])
  @@index([moduleId])
  @@map("student_module_releases")
}

/// Weekly attendance for an in-person student in a course. Week N corresponds
/// to the Nth module (by orderIndex). A missing row = "not recorded yet".
model AttendanceRecord {
  id           String           @id @default(cuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  week         Int
  status       AttendanceStatus
  recordedById String?
  recordedBy   Instructor?      @relation(fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, courseId, week])
  @@index([courseId])
  @@map("attendance_records")
}
