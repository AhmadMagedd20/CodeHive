# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# Database: Supabase (managed Postgres). Get the strings from your Supabase
# project → "Connect" → ORM (Prisma).
#
# For a long-running server (Next.js dev/node), use the SESSION pooler (port
# 5432) for BOTH urls — it's the most reliable here. (The transaction pooler on
# 6543 + ?pgbouncer=true is only preferable for serverless/edge deployments.)
#
#   DATABASE_URL = Session pooler, port 5432 — app runtime
#   DIRECT_URL   = Session pooler, port 5432 — prisma migrate
#
# Example shape (replace [REF], [PASSWORD], [REGION]; encode @ in the password
# as %40):
#   DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#   DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Local Docker Postgres alternative (see docker-compose.yml) — set both the same:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lms?schema=public"
DATABASE_URL=""
DIRECT_URL=""

# Secret used to HMAC-sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used in email links + https redirect).
APP_URL="http://localhost:3000"

# --- Email -----------------------------------------------------------------
# Defaults to `console` in development and `resend` in production, so a deploy
# can't silently console-log its verification emails. Setting this explicitly
# always wins. Boot FAILS if the chosen provider's credential is missing —
# email verification is step one of every signup, so a silent drop is worse
# than a loud crash.
#
# console = log the email + link to the server console (no provider needed)
# smtp    = send via SMTP (nodemailer)
# resend  = send via Resend HTTP API  <- production
#
# DO NOT ship Gmail SMTP to production. Free Gmail caps around 500 sends/day,
# throttles bursts, and — because the From address is @gmail.com — you cannot
# align SPF/DKIM to your own domain, so verification mail lands in spam far
# more often. It is fine for local testing only.
EMAIL_PROVIDER="console"

# Must be an address on a domain you have VERIFIED with the provider. Resend
# will reject a @gmail.com sender outright.
EMAIL_FROM="Cohort Portal <no-reply@yourdomain.com>"

# Required only when EMAIL_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Required only when EMAIL_PROVIDER=resend
RESEND_API_KEY=""

# --- Token / session lifetimes (optional; sensible defaults) ---------------
EMAIL_VERIFICATION_TTL_HOURS="48"
PASSWORD_RESET_TTL_MINUTES="60"
SESSION_INACTIVITY_MINUTES="30"

# --- Login throttling (optional) -------------------------------------------
MAX_LOGIN_ATTEMPTS="5"
LOGIN_LOCK_MINUTES="15"

# --- Bot protection (optional) ---------------------------------------------
# When false, registration uses only honeypot + rate limiting (CAPTCHA stubbed).
CAPTCHA_ENABLED="false"
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Future-proofing seam (optional) ---------------------------------------
# Global flag for the 2FA seam. No 2FA logic is built yet.
TWO_FACTOR_ENABLED="false"

# --- Phase 2: content, media & scheduling ----------------------------------
# Video hosting behind a provider-agnostic interface.
#   local = dev only. Stores the file on disk, plays it in a plain <video>.
#           Works with no Bunny credentials so you can run offline.
#   bunny = production. Browser-direct resumable upload, iframe playback.
VIDEO_PROVIDER="local"

# --- Bunny Stream (required when VIDEO_PROVIDER=bunny) ---------------------
# Dashboard → Stream → your library → "API" tab.
#
# BUNNY_STREAM_LIBRARY_ID — the numeric Video Library ID shown at the top of
#   the API tab (e.g. 123456).
# BUNNY_STREAM_API_KEY    — the library's API key on that same tab. This is a
#   SERVER-ONLY secret: it signs uploads and never reaches the browser.
# BUNNY_STREAM_TOKEN_KEY  — the "Token Authentication Key" under the library's
#   Security tab. Optional but strongly recommended: with it, embed links
#   carry ?token=&expires= and stop working once they expire. Without it,
#   anyone with the URL can watch indefinitely.
#
# Also configure in the Bunny dashboard (not env vars):
#   Security → enable "Token Authentication"
#   Security → "Allowed Referrers": add your production domain so the player
#              refuses to run when embedded anywhere else.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_TOKEN_KEY=""

# File storage for documents, submissions, announcement images, certificates.
# "local" writes to STORAGE_DIR (dev only); "supabase" uses Supabase Storage.
STORAGE_PROVIDER="local"
STORAGE_DIR="./storage"

# Only needed when STORAGE_PROVIDER=supabase:
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="cohort-media"

# Scheduled jobs (publish/announcements/reminders). Set a strong secret and
# have a scheduler POST /api/cron/tick with header `x-cron-secret`. Unset =
# endpoint disabled.
CRON_SECRET=""
AT_RISK_INACTIVE_DAYS="7"
ASSIGNMENT_REMINDER_HOURS="24"

# --- Seed data (optional; used by `pnpm db:seed`) --------------------------
SEED_INSTRUCTOR_EMAIL="admin@lms.local"
SEED_INSTRUCTOR_PASSWORD="Admin!12345"
SEED_INSTRUCTOR_NAME="Course Instructor"

# --- Telegram alerts for the instructor (optional) -------------------------
# A second notification channel, in addition to (never replacing) the student
# emails above: you get a direct message when someone registers or submits a
# payment. Leave both blank and the app behaves exactly as before — it just
# logs that Telegram isn't configured and skips the message.
#
# TELEGRAM_BOT_TOKEN — message @BotFather on Telegram, send /newbot, follow the
#   prompts, and copy the token it gives you (looks like 123456:ABC-DEF...).
# TELEGRAM_CHAT_ID   — send your new bot any message first, then open
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates in a browser and read
#   `result[0].message.chat.id`. For a personal chat it's your user id; for a
#   group it's negative (e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
