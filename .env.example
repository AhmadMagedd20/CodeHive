# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# Database: Supabase (managed Postgres). Get the strings from your Supabase
# project → "Connect" → ORM (Prisma).
#
# For a long-running server (Next.js dev/node), use the SESSION pooler (port
# 5432) for BOTH urls — it's the most reliable here. (The transaction pooler on
# 6543 + ?pgbouncer=true is only preferable for serverless/edge deployments.)
#
#   DATABASE_URL = Session pooler, port 5432 — app runtime
#   DIRECT_URL   = Session pooler, port 5432 — prisma migrate
#
# Example shape (replace [REF], [PASSWORD], [REGION]; encode @ in the password
# as %40):
#   DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#   DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Local Docker Postgres alternative (see docker-compose.yml) — set both the same:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lms?schema=public"
DATABASE_URL=""
DIRECT_URL=""

# Secret used to HMAC-sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used in email links + https redirect).
APP_URL="http://localhost:3000"

# --- Email (optional; defaults to console logging in dev) ------------------
# console = log the email + link to the server console (no provider needed)
# smtp    = send via SMTP (nodemailer)
# resend  = send via Resend HTTP API
EMAIL_PROVIDER="console"
EMAIL_FROM="The Cohort Portal <no-reply@example.com>"

# Required only when EMAIL_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Required only when EMAIL_PROVIDER=resend
RESEND_API_KEY=""

# --- Token / session lifetimes (optional; sensible defaults) ---------------
EMAIL_VERIFICATION_TTL_HOURS="48"
PASSWORD_RESET_TTL_MINUTES="60"
SESSION_INACTIVITY_MINUTES="30"

# --- Login throttling (optional) -------------------------------------------
MAX_LOGIN_ATTEMPTS="5"
LOGIN_LOCK_MINUTES="15"

# --- Bot protection (optional) ---------------------------------------------
# When false, registration uses only honeypot + rate limiting (CAPTCHA stubbed).
CAPTCHA_ENABLED="false"
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Future-proofing seam (optional) ---------------------------------------
# Global flag for the 2FA seam. No 2FA logic is built yet.
TWO_FACTOR_ENABLED="false"

# --- Phase 2: content, media & scheduling ----------------------------------
# Video hosting behind a provider-agnostic interface. Only "local" is built
# (placeholder, dev-only signed streaming); Cloudflare Stream/Bunny/Mux plug in
# later without touching the app.
VIDEO_PROVIDER="local"

# File storage for documents, submissions, announcement images, certificates.
# "local" writes to STORAGE_DIR (dev only); "supabase" uses Supabase Storage.
STORAGE_PROVIDER="local"
STORAGE_DIR="./storage"

# Only needed when STORAGE_PROVIDER=supabase:
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="cohort-media"

# Scheduled jobs (publish/announcements/reminders). Set a strong secret and
# have a scheduler POST /api/cron/tick with header `x-cron-secret`. Unset =
# endpoint disabled.
CRON_SECRET=""
AT_RISK_INACTIVE_DAYS="7"
ASSIGNMENT_REMINDER_HOURS="24"

# --- Seed data (optional; used by `pnpm db:seed`) --------------------------
SEED_INSTRUCTOR_EMAIL="admin@lms.local"
SEED_INSTRUCTOR_PASSWORD="Admin!12345"
SEED_INSTRUCTOR_NAME="Course Instructor"
